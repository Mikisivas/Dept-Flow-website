# Dept-Flow — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#
# Two of these are public by design and appear in the browser bundle. The rest
# are secrets that must never reach the client, never be committed, and never
# be pasted into a chat window.

# ---------------------------------------------------------------------------
# Supabase — public
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://ksqefrcxjhazsyrikxbd.supabase.co

# The anon key. Public by design — its JWT payload literally says role: anon,
# and row-level security is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — secret. Server only.
# ---------------------------------------------------------------------------

# Bypasses row-level security entirely. Anything holding this key can read and
# write every row for every student. Server-side only, always.
SUPABASE_SERVICE_ROLE_KEY=

# Settings → API → JWT Settings → JWT Secret.
#
# This signs the login session token, so there is no separate session secret to
# invent. Signing with the project's own secret is the whole trick: Supabase
# accepts our token, auth.uid() resolves to the account inside it, and every
# RLS policy applies to a login that never involved an email address.
SUPABASE_JWT_SECRET=

# Settings → Database → Connection string. Only needed to apply migrations with
# the Supabase CLI; not needed if you paste supabase/setup.sql into the SQL
# Editor instead.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Where this site is reachable
# ---------------------------------------------------------------------------

# Paystack sends the student back here after checkout, so it must be an address
# their phone can actually reach. Defaults to http://localhost:3000; set it for
# anything else, including a LAN address while testing on a real phone.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Scheduled compliance transition
# ---------------------------------------------------------------------------

# Only needed if you drive /api/cron/compliance from an external scheduler.
# The preferred route is pg_cron inside Supabase, which needs no secret at all —
# see supabase/migrations/..._compliance_schedule.sql.
#
# Any long random string. The endpoint refuses to run without it, because it can
# lock a whole department out of paying.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Paystack
# ---------------------------------------------------------------------------

# Secret key. Initialises transactions and verifies them. Server only.
#
# There is no public key here. Dept-Flow uses the redirect flow — the server
# initialises the transaction and sends the student to Paystack's own page —
# rather than the inline popup, which is the only thing the public key is for.
# On a phone on a poor connection, a full page beats a third-party script and
# an iframe. An unused variable in this file is a trap, so it is not listed.
PAYSTACK_SECRET_KEY=
