{
  "name": "dept-flow-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:icons": "node scripts/build-icons.mjs",
    "build:setup": "node scripts/build-setup.mjs",
    "dev": "next dev",
    "lint": "eslint",
    "start": "next start",
    "test": "npm run test:paystack && npm run test:reset && npm run test:timetable",
    "test:paystack": "node --conditions=react-server --experimental-strip-types tests/paystack.mts",
    "test:reset": "node --conditions=react-server --experimental-strip-types --experimental-test-module-mocks --import ./tests/register-hooks.mjs tests/password-reset.mts",
    "test:timetable": "node --conditions=react-server --experimental-strip-types --import ./tests/register-hooks.mjs tests/timetable-csv.mts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@node-rs/bcrypt": "^1.10.7",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.7",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
